#prevent User access Directories
Options -Indexes

#enable mod_rewrite
RewriteEngine On

RewriteCond %{HTTP_HOST} ^www\.dkctfwrs\.com$

RewriteRule ^/?$ "https\:\/\/dkctfwrs\.com\/" [R=301,L]

RewriteCond %{REQUEST_FILENAME} !-d

RewriteCond %{REQUEST_FILENAME}\.php -f

RewriteRule ^Admin/([0-9]+)/([0-9a-zA-Z_-]+) Login.php?id=$1$name=$2